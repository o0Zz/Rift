{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rift",
  "version": "../package.json",
  "identifier": "dev.rift.terminal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rift",
        "width": 1200,
        "height": 800,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3MTc4MjZENTZDMzVCQjYKUldTMlc4TldiWUlYWndpZGlnc1NiWm1TWjh3ZkxFQUJVL2Fqc3AvWVpKa3NndG1kdTZDcHBSTkgK",
      "endpoints": [
        "https://github.com/o0Zz/rift/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
